generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String
  budget    String
  message   String
  source    String?
  createdAt DateTime @default(now())
}
